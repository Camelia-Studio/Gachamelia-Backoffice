{% extends 'base_backoffice.html.twig' %}

{% block title %}Fiche personnage - {{ guild.name }} - Gachamélia Backoffice{% endblock %}

{% block navbar_actions %}
    <a href="{{ path('app_dashboard') }}" class="bo-btn bo-btn--outline">Serveurs</a>
{% endblock %}

{% block body %}
    <section class="bo-page" data-testid="character-sheet">
        <header class="bo-page-header bo-page-header--split">
            <div class="bo-stack bo-stack--tight">
                <div class="bo-inline bo-inline--center bo-inline--nowrap">
                    {% if guild.icon_url %}
                        <img src="{{ guild.icon_url }}" alt="" width="40" height="40" class="bo-avatar bo-avatar--sm">
                    {% else %}
                        <span class="bo-avatar bo-avatar--sm bo-avatar--fallback" aria-hidden="true">
                            {{ guild.name|slice(0, 1)|upper }}
                        </span>
                    {% endif %}
                    <p class="bo-eyebrow bo-eyebrow--wrap">{{ guild.name }}</p>
                </div>
                <h1 class="bo-page-title">Fiche personnage</h1>
            </div>
            {% if not guild.active %}
                <span class="bo-badge bo-badge--muted bo-badge--lg">Serveur inactif</span>
            {% endif %}
        </header>

        {% if character_sheet is null %}
            <article class="bo-sheet-empty" data-testid="character-sheet-empty-state">
                <div class="bo-sheet-ring bo-sheet-ring--blush" aria-hidden="true"></div>
                <div class="bo-sheet-empty-body">
                    <span class="bo-avatar bo-avatar--md bo-avatar--fallback" aria-hidden="true">?</span>
                    <div class="bo-stack bo-stack--tight">
                        <p class="bo-sheet-empty-title">Ton personnage n’a pas encore été créé sur ce serveur.</p>
                        <p class="bo-panel-lead">
                            Utilise la commande
                            <code class="bo-code">/ficheperso</code>
                            sur Discord, puis reviens ici pour découvrir ton rang, ton rôle, tes éléments et tes statistiques.
                        </p>
                    </div>
                </div>
            </article>
        {% else %}
            <article class="bo-sheet" data-testid="character-sheet-card">
                <div class="bo-sheet-hero">
                    <div class="bo-sheet-ring bo-sheet-ring--rose" aria-hidden="true"></div>
                    <div class="bo-sheet-identity" data-testid="character-sheet-identity">
                        <p class="bo-sheet-eyebrow">Membre Discord</p>
                        <div class="bo-inline bo-inline--center bo-inline--nowrap bo-inline--wide">
                            {% if profile.avatar_url %}
                                <img
                                    src="{{ profile.avatar_url }}"
                                    alt="Avatar de {{ profile.global_name ?? profile.username }}"
                                    width="56"
                                    height="56"
                                    class="bo-avatar bo-avatar--lg bo-avatar--on-dark"
                                >
                            {% else %}
                                <span class="bo-avatar bo-avatar--lg bo-avatar--on-dark bo-avatar--fallback" data-testid="character-sheet-avatar-fallback" aria-hidden="true">
                                    {{ (profile.global_name ?? profile.username)|slice(0, 1)|upper }}
                                </span>
                            {% endif %}
                            <div class="bo-sheet-name-block">
                                <p class="bo-sheet-name">{{ profile.global_name ?? profile.username }}</p>
                                <p class="bo-sheet-handle">@{{ profile.username }}</p>
                            </div>
                        </div>
                    </div>

                    <div class="bo-sheet-rank" data-testid="character-sheet-rank">
                        <span class="bo-sheet-rank-label">Rang</span>
                        <strong class="bo-sheet-rank-name">
                            {{ character_sheet.rank ? character_sheet.rank.name : 'Non attribué' }}
                        </strong>
                        {% if character_sheet.rank and character_sheet.rank.is_staff %}
                            <span class="bo-sheet-rank-staff">Staff</span>
                        {% endif %}
                    </div>
                </div>

                <dl class="bo-sheet-progression" data-testid="character-sheet-progression">
                    <div>
                        <dt>XP dans ce rang</dt>
                        <dd>{{ character_sheet.progression.xp|number_format(0, ',', ' ') }}</dd>
                    </div>
                    <div>
                        <dt>XP au total</dt>
                        <dd>{{ character_sheet.progression.total_xp|number_format(0, ',', ' ') }}</dd>
                    </div>
                    <div>
                        <dt>Constellations</dt>
                        <dd>{{ character_sheet.progression.constellations|number_format(0, ',', ' ') }}</dd>
                    </div>
                </dl>

                <div class="bo-sheet-body">
                    <div class="bo-sheet-column">
                        <section class="bo-stack bo-stack--tight" data-testid="character-sheet-role">
                            <p class="bo-label">Rôle</p>
                            <div class="bo-sheet-role">
                                {% if character_sheet.role %}
                                    {% if character_sheet.role.emoji_url %}
                                        <img src="{{ character_sheet.role.emoji_url }}" alt="" width="40" height="40" class="bo-emoji bo-emoji--lg" loading="lazy">
                                    {% else %}
                                        <span class="bo-sheet-role-glyph" aria-hidden="true">{{ character_sheet.role.emoji }}</span>
                                    {% endif %}
                                    <strong class="bo-sheet-role-name">{{ character_sheet.role.name }}</strong>
                                {% else %}
                                    <strong class="bo-sheet-role-name bo-sheet-role-name--muted">Non attribué</strong>
                                {% endif %}
                            </div>
                        </section>

                        <section class="bo-stack bo-stack--tight" data-testid="character-sheet-elements">
                            <p class="bo-label">Éléments</p>
                            {% if character_sheet.elements is empty %}
                                <p class="bo-muted-strong">Aucun élément</p>
                            {% else %}
                                <ul class="bo-inline" role="list">
                                    {% for element in character_sheet.elements %}
                                        <li class="bo-pill">
                                            {% if element.emoji_url %}
                                                <img src="{{ element.emoji_url }}" alt="" width="24" height="24" class="bo-emoji" loading="lazy">
                                            {% else %}
                                                <span class="bo-pill-glyph" aria-hidden="true">{{ element.emoji }}</span>
                                            {% endif %}
                                            <span class="bo-wrap">{{ element.name }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </section>
                    </div>

                    <section class="bo-stack bo-stack--tight bo-sheet-column">
                        <div>
                            <p class="bo-label">Caractéristiques</p>
                            <h2 class="bo-sheet-stats-title">Statistiques</h2>
                        </div>
                        {% if character_sheet.stats is empty %}
                            <p class="bo-empty">Aucune statistique</p>
                        {% else %}
                            <dl class="bo-sheet-stats" data-testid="character-sheet-stats">
                                {% for stat in character_sheet.stats %}
                                    <div class="bo-sheet-stat">
                                        <dt>{{ stat.name }}</dt>
                                        <dd>{{ stat.value }}</dd>
                                    </div>
                                {% endfor %}
                            </dl>
                        {% endif %}
                    </section>
                </div>
            </article>
        {% endif %}
    </section>
{% endblock %}
