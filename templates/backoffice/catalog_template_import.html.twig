{% extends 'base_backoffice.html.twig' %}

{% block title %}Importer {{ template.name }} - {{ guild.name }} - Gachamélia Backoffice{% endblock %}

{% block navbar_actions %}
    <a href="{{ path('app_server_catalog_template_imports', { guildId: guild.id }) }}" class="bo-btn bo-btn--outline">Modèles</a>
    <a href="{{ path('app_server_configuration', { guildId: guild.id }) }}" class="bo-btn bo-btn--outline">Configuration</a>
{% endblock %}

{% block body %}
    <section class="bo-page" data-testid="template-import-panel">
        <header class="bo-page-header">
            <p class="bo-eyebrow">{{ guild.name }} · Import</p>
            <h1 class="bo-page-title">{{ template.name }}</h1>
            <p class="bo-page-lead">
                Cet import écrasera le catalogue actuel du serveur : rangs, rôles, stats, éléments, probabilités et messages seront remplacés.
            </p>
        </header>

        {% include 'backoffice/_catalog_validation.html.twig' with { validation: preview.validation } only %}

        <section class="bo-stats" data-testid="template-import-summary">
            <article class="bo-stat" data-testid="template-import-current">
                <p class="bo-stat-label">Catalogue actuel</p>
                <p class="bo-stat-value">{{ preview.current.total }}</p>
                <p class="bo-caption">entrées supprimées</p>
            </article>
            <article class="bo-stat bo-stat--leaf" data-testid="template-import-incoming">
                <p class="bo-stat-label">Catalogue importé</p>
                <p class="bo-stat-value">{{ preview.incoming.total }}</p>
                <p class="bo-caption">entrées créées</p>
            </article>
            <article class="bo-stat bo-stat--rose" data-testid="template-import-affected-users">
                <p class="bo-stat-label">Personnages affectés</p>
                <p class="bo-stat-value">{{ preview.affected_user_count }}</p>
                <p class="bo-caption">{{ preview.affected_user_count > 1 ? 'personnages' : 'personnage' }} à réattribuer</p>
            </article>
        </section>

        <div class="bo-columns bo-columns--side">
            <section class="bo-panel bo-panel--rose">
                <div class="bo-panel-head">
                    <div>
                        <h2 class="bo-section-title">Correction des rôles Discord</h2>
                        <p class="bo-panel-lead">Chaque rang du modèle doit pointer vers un rôle Discord existant sur ce serveur.</p>
                    </div>
                </div>
                <form method="post" action="{{ path('app_server_catalog_template_import_apply', { guildId: guild.id, templateId: template.id }) }}" class="bo-panel-body bo-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
                    <input type="hidden" name="import_fingerprint" value="{{ import_fingerprint }}">
                    {% if discord_resources.roles is empty %}
                        <p class="bo-notice bo-notice--rose">
                            Rôles Discord temporairement indisponibles. L’import sera possible dès que les rôles assignables pourront être vérifiés.
                        </p>
                    {% endif %}

                    {% for rank in catalog.ranks %}
                        <label class="bo-field">
                            <span>{{ rank.name }} <span class="bo-accent">({{ rank.role_key }})</span></span>
                            {% if discord_resources.roles is not empty %}
                                <select name="rank_roles[{{ rank.id }}]" required class="bo-input">
                                    <option value="">Choisis un rôle Discord</option>
                                    {% for role in discord_resources.roles %}
                                        <option value="{{ role.id }}">{{ role.label }}</option>
                                    {% endfor %}
                                </select>
                            {% else %}
                                <input disabled placeholder="Rôles Discord indisponibles" class="bo-input">
                            {% endif %}
                        </label>
                    {% else %}
                        <p class="bo-empty">Ce modèle ne contient aucun rang à relier.</p>
                    {% endfor %}

                    <label class="bo-check bo-check--rose">
                        <input name="confirm_overwrite" type="checkbox" value="1" required>
                        Je confirme que le catalogue actuel et les attributions associées seront écrasés.
                    </label>

                    <button type="submit" {% if not preview.validation.ready or discord_resources.roles is empty %}disabled{% endif %} class="bo-btn bo-btn--rose bo-btn--lg">
                        Écraser et importer
                    </button>
                </form>
            </section>

            <section class="bo-panel" data-testid="template-import-preview">
                <div class="bo-panel-head">
                    <div>
                        <h2 class="bo-section-title">Contenu importé</h2>
                        <p class="bo-panel-lead">Aperçu du catalogue global avant remplacement.</p>
                    </div>
                    <span class="bo-badge bo-badge--gold">{{ template.total_count }} entrées</span>
                </div>
                <div class="bo-panel-body bo-stack">
                    {% set rows = [
                        { label: 'Rangs', count: catalog.ranks|length },
                        { label: 'Stats de rôle', count: catalog.role_stats|length },
                        { label: 'Messages d’arrivée', count: catalog.welcome_messages|length },
                        { label: 'Messages de départ', count: catalog.bye_messages|length },
                        { label: 'Rôles', count: catalog.roles|length },
                        { label: 'Stats', count: catalog.stats|length },
                        { label: 'Éléments', count: catalog.elements|length },
                    ] %}
                    {% for row in rows %}
                        <article class="bo-row">
                            <span class="bo-row-label">{{ row.label }}</span>
                            <span class="bo-badge bo-badge--gold">{{ row.count }}</span>
                        </article>
                    {% endfor %}
                </div>
            </section>
        </div>
    </section>
{% endblock %}
