{% extends 'base_backoffice.html.twig' %}

{% block title %}Importer un modèle - {{ guild.name }} - Gachamélia Backoffice{% endblock %}

{% block navbar_actions %}
    <a href="{{ path('app_server_configuration', { guildId: guild.id }) }}" class="bo-btn bo-btn--outline">Configuration</a>
{% endblock %}

{% block body %}
    <section class="bo-page" data-testid="template-imports">
        <header class="bo-page-header">
            <p class="bo-eyebrow">{{ guild.name }} · Import</p>
            <h1 class="bo-page-title">Importer un modèle</h1>
            <p class="bo-page-lead">
                L’import remplacera le catalogue actuel du serveur après confirmation sur l’écran suivant.
            </p>
        </header>

        <div class="bo-card-grid">
            {% for template in templates %}
                <article class="bo-template-card" data-testid="importable-template-card">
                    <div class="bo-panel-head bo-panel-head--bare">
                        <span class="bo-template-mark">MD</span>
                        <span class="bo-badge bo-badge--gold bo-badge--lg">{{ template.total_count }} entrées</span>
                    </div>
                    <div>
                        <h2 class="bo-card-heading">{{ template.name }}</h2>
                        {% if template.description %}
                            <p class="bo-panel-lead">{{ template.description }}</p>
                        {% endif %}
                    </div>
                    <a href="{{ path('app_server_catalog_template_import', { guildId: guild.id, templateId: template.id }) }}" class="bo-btn bo-btn--ink bo-btn--lg bo-template-action">
                        Préparer l’import
                    </a>
                </article>
            {% else %}
                <p class="bo-empty">Aucun modèle publié pour le moment.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
