{% extends 'base_backoffice.html.twig' %}

{% block title %}Modèles de catalogue - Gachamélia Backoffice{% endblock %}

{% block navbar_actions %}
    <a href="{{ path('app_dashboard') }}" class="bo-btn bo-btn--outline">Serveurs</a>
{% endblock %}

{% block body %}
    <section class="bo-page" data-testid="catalog-templates">
        <header class="bo-page-header">
            <p class="bo-eyebrow">Administration globale</p>
            <h1 class="bo-page-title">Modèles de catalogue</h1>
            <p class="bo-page-lead">
                Prépare des catalogues complets que les serveurs pourront importer quand ils veulent démarrer proprement.
            </p>
        </header>

        <div class="bo-columns bo-columns--side">
            <section class="bo-panel" data-testid="catalog-template-create-panel">
                <div class="bo-panel-head">
                    <div>
                        <h2 class="bo-section-title">Créer un modèle</h2>
                        <p class="bo-panel-lead">Le contenu se configure ensuite section par section.</p>
                    </div>
                </div>
                <form method="post" action="{{ path('app_catalog_template_create') }}" class="bo-panel-body bo-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
                    <label class="bo-field">
                        Nom
                        <input name="name" required class="bo-input">
                    </label>
                    <label class="bo-field">
                        Description
                        <textarea name="description" rows="4" class="bo-input bo-textarea"></textarea>
                    </label>
                    <button type="submit" class="bo-btn bo-btn--ink bo-btn--lg">Créer le modèle</button>
                </form>
            </section>

            <section class="bo-panel" data-testid="catalog-template-list-panel">
                <div class="bo-panel-head">
                    <div>
                        <h2 class="bo-section-title">Modèles existants</h2>
                        <p class="bo-panel-lead">Seuls les modèles publiés sont proposés à l’import côté serveur.</p>
                    </div>
                    <span class="bo-badge bo-badge--gold">{{ templates|length }} modèles</span>
                </div>
                <div class="bo-panel-body bo-stack">
                    {% for template in templates %}
                        <article class="bo-guild" data-testid="catalog-template-card">
                            <div class="bo-guild-text">
                                <div class="bo-inline">
                                    <h3 class="bo-guild-name">{{ template.name }}</h3>
                                    <span class="bo-badge {{ template.published ? 'bo-badge--leaf' : 'bo-badge--rose' }}">
                                        {{ template.published ? 'Publié' : 'Brouillon' }}
                                    </span>
                                </div>
                                {% if template.description %}
                                    <p class="bo-panel-lead">{{ template.description }}</p>
                                {% endif %}
                                <p class="bo-caption">{{ template.total_count }} entrées</p>
                            </div>
                            <a href="{{ path('app_catalog_template_configuration', { templateId: template.id }) }}" class="bo-btn bo-btn--ink">
                                Configurer
                            </a>
                        </article>
                    {% else %}
                        <p class="bo-empty">Aucun modèle pour le moment.</p>
                    {% endfor %}
                </div>
            </section>
        </div>
    </section>
{% endblock %}
