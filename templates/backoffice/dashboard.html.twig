{% extends 'base_backoffice.html.twig' %}

{% macro guild_card(guild, inactive) %}
    <article class="bo-guild{{ inactive ? ' is-inactive' }}" data-testid="guild-{{ guild.id }}">
        <div class="bo-guild-main">
            {% if guild.icon_url %}
                <img
                    src="{{ guild.icon_url }}"
                    alt="Logo {{ guild.name }}"
                    width="48"
                    height="48"
                    class="bo-guild-icon"
                    loading="lazy"
                >
            {% else %}
                <span class="bo-guild-icon bo-guild-icon--fallback" data-testid="guild-icon-fallback" aria-hidden="true">
                    {{ guild.name|slice(0, 1)|upper }}
                </span>
            {% endif %}
            <div class="bo-guild-text">
                <div class="bo-inline">
                    <h2 class="bo-guild-name">{{ guild.name }}</h2>
                    {% if inactive %}
                        <span class="bo-badge bo-badge--muted">Inactif</span>
                    {% endif %}
                </div>
                <p class="bo-guild-role">
                    {{ guild.canManageConfiguration ? 'Administration' : 'Membre' }}
                </p>
            </div>
        </div>
        <div class="bo-inline">
            {% if guild.canManageConfiguration %}
                <a
                    href="{{ path('app_server_configuration', { guildId: guild.id }) }}"
                    class="bo-btn {{ inactive ? 'bo-btn--outline bo-btn--muted' : 'bo-btn--leaf' }}"
                >
                    {{ inactive ? 'Consulter' : 'Configuration' }}
                </a>
            {% endif %}
            <a href="{{ path('app_character_sheet', { guildId: guild.id }) }}" class="bo-btn bo-btn--blush">
                Fiche personnage
            </a>
        </div>
    </article>
{% endmacro %}

{% import _self as ui %}

{% block title %}Serveurs Discord - Gachamélia Backoffice{% endblock %}

{% block navbar_actions %}
    <form method="post" action="{{ path('app_logout') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <button type="submit" class="bo-btn bo-btn--ink">Déconnexion</button>
    </form>
{% endblock %}

{% block body %}
    <section class="bo-page" data-testid="backoffice-dashboard">
        <header class="bo-page-header">
            <p class="bo-eyebrow">Serveurs Discord</p>
            <h1 class="bo-page-title">Choisir un serveur</h1>
            {% if profile %}
                <div class="bo-inline bo-inline--center">
                    <p class="bo-page-lead">{{ profile.global_name ?? profile.username }}</p>
                    {% if profile.can_manage_catalog_templates %}
                        <a href="{{ path('app_catalog_templates') }}" class="bo-btn bo-btn--rose-soft bo-btn--sm" data-testid="catalog-template-admin-link">
                            Modèles
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </header>

        {% if guilds is empty %}
            <div class="bo-card">
                <p class="bo-card-title">Aucun serveur disponible</p>
                <p class="bo-card-text">Le bot Gachamélia doit être présent sur au moins un serveur Discord commun.</p>
            </div>
        {% else %}
            <div class="bo-page">
                <section class="bo-stack" data-testid="active-guilds">
                    <div>
                        <h2 class="bo-section-title">Serveurs actifs</h2>
                        <p class="bo-section-lead">Le bot est actuellement présent sur ces serveurs.</p>
                    </div>
                    {% for guild in active_guilds %}
                        {{ ui.guild_card(guild, false) }}
                    {% else %}
                        <p class="bo-empty">Aucun serveur actif.</p>
                    {% endfor %}
                </section>

                {% if inactive_guilds is not empty %}
                    <section class="bo-stack bo-stack--divided" data-testid="inactive-guilds">
                        <div>
                            <h2 class="bo-section-title">Serveurs inactifs</h2>
                            <p class="bo-section-lead">Leur catalogue est conservé en lecture seule jusqu’au retour du bot.</p>
                        </div>
                        {% for guild in inactive_guilds %}
                            {{ ui.guild_card(guild, true) }}
                        {% endfor %}
                    </section>
                {% endif %}
            </div>
        {% endif %}
    </section>
{% endblock %}
