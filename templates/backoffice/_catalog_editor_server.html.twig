{% import 'backoffice/_emoji_picker.html.twig' as ui %}
{% if active_section == 'ranks' %}
    <form method="post" action="{{ path('app_server_catalog_rank_update', { guildId: guild.id, rankId: rank.id }) }}" class="bo-form bo-form--tight bo-subform">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <div class="bo-form-row bo-form-row--half">
            <label class="bo-field">
                Rôle Discord
                {% if discord_resources.roles is not empty %}
                    <select name="discord_id" required class="bo-input">
                        {% if rank.discord_id not in discord_resource_ids.roles %}
                            <option value="{{ rank.discord_id }}" selected>ID actuel introuvable ({{ rank.discord_id }})</option>
                        {% endif %}
                        {% for role in discord_resources.roles %}
                            <option value="{{ role.id }}" {% if rank.discord_id == role.id %}selected{% endif %}>{{ role.label }}</option>
                        {% endfor %}
                    </select>
                {% else %}
                    <input name="discord_id" value="{{ rank.discord_id }}" required inputmode="numeric" placeholder="ID du rôle Discord" class="bo-input">
                {% endif %}
            </label>
            <label class="bo-field">
                Nom
                <input aria-label="Nom" name="name" value="{{ rank.name }}" required class="bo-input">
            </label>
        </div>
        <div class="bo-form-row bo-form-row--pct">
            <label class="bo-field">
                Titre du message de départ
                <input name="bye_title" value="{{ rank.bye_title }}" class="bo-input">
            </label>
            <label class="bo-field">
                %
                <input name="percentage" type="number" min="0" max="100" value="{{ rank.percentage }}" required class="bo-input">
            </label>
        </div>
        <div class="bo-inline bo-inline--between bo-inline--center">
            <label class="bo-check bo-check--box bo-check--compact">
                <input name="is_staff" type="checkbox" value="1" {% if rank.is_staff %}checked{% endif %}>
                Rang staff
            </label>
            <button type="submit" class="bo-btn bo-btn--ink bo-btn--lg">Enregistrer</button>
        </div>
    </form>
    <form method="post" action="{{ path('app_server_catalog_rank_delete', { guildId: guild.id, rankId: rank.id }) }}" class="bo-start">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <button type="submit" class="bo-btn bo-btn--danger">Supprimer le rang</button>
    </form>
{% elseif active_section == 'role-stats' %}
    <form method="post" action="{{ path('app_server_catalog_role_stat_upsert_dedicated', { guildId: guild.id }) }}" class="bo-form-row bo-form-row--inline-edit">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <input type="hidden" name="role_id" value="{{ role_stat.role_id }}">
        <input type="hidden" name="stat_id" value="{{ role_stat.stat_id }}">
        <label class="bo-field">
            Association
            <input value="{{ role_stat.role_name }} · {{ role_stat.stat_name }}" disabled class="bo-input bo-input--ivory">
        </label>
        <label class="bo-field">
            %
            <input name="percentage" type="number" min="0" max="100" value="{{ role_stat.percentage }}" required class="bo-input">
        </label>
        <button type="submit" class="bo-btn bo-btn--ink bo-btn--lg">Enregistrer</button>
    </form>
    <form method="post" action="{{ path('app_server_catalog_role_stat_delete_dedicated', { guildId: guild.id, roleId: role_stat.role_id, statId: role_stat.stat_id }) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <button type="submit" class="bo-btn bo-btn--danger">Supprimer</button>
    </form>
{% elseif active_section in ['welcome-messages', 'bye-messages'] %}
    <form method="post" action="{{ path(update_route, { guildId: guild.id, messageId: message.id }) }}" class="bo-form bo-form--tight">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <label class="bo-field">
            Message
            <textarea name="message" required maxlength="255" rows="4" class="bo-input bo-textarea bo-textarea--ivory bo-textarea--tall">{{ message.message }}</textarea>
        </label>
        <div class="bo-inline">
            <button type="submit" class="bo-btn bo-btn--ink bo-btn--lg">Enregistrer</button>
        </div>
    </form>
    <form method="post" action="{{ path(delete_route, { guildId: guild.id, messageId: message.id }) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <button type="submit" class="bo-btn bo-btn--danger">Supprimer</button>
    </form>
{% elseif active_section == 'roles' %}
    <form method="post" action="{{ path('app_server_catalog_role_update', { guildId: guild.id, roleId: role.id }) }}" class="bo-form bo-form--tight" data-emoji-picker data-emoji-picker-default="{{ role.emoji_markup }}">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <div class="bo-form-row bo-form-row--pct">
            <label class="bo-field">
                Nom
                <input aria-label="Nom" name="name" value="{{ role.name }}" required class="bo-input">
            </label>
            <label class="bo-field">
                %
                <input name="percentage" type="number" min="0" max="100" value="{{ role.percentage }}" required class="bo-input">
            </label>
        </div>
        {{ ui.emoji_picker(role.emoji_source, role.emoji_markup, emoji_picker, 'gold') }}
        <button type="submit" class="bo-btn bo-btn--ink bo-btn--lg bo-btn--start">Enregistrer</button>
    </form>
    <form method="post" action="{{ path('app_server_catalog_role_delete', { guildId: guild.id, roleId: role.id }) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <button type="submit" class="bo-btn bo-btn--danger">Supprimer</button>
    </form>
{% elseif active_section == 'stats' %}
    <form method="post" action="{{ path('app_server_catalog_stat_update', { guildId: guild.id, statId: stat.id }) }}" class="bo-form bo-form--tight">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <label class="bo-field">
            Nom
            <input aria-label="Nom" name="name" value="{{ stat.name }}" required class="bo-input">
        </label>
        <button type="submit" class="bo-btn bo-btn--ink bo-btn--lg">Enregistrer</button>
    </form>
    <form method="post" action="{{ path('app_server_catalog_stat_delete', { guildId: guild.id, statId: stat.id }) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <button type="submit" class="bo-btn bo-btn--danger">Supprimer</button>
    </form>
{% elseif active_section == 'elements' %}
    <form method="post" action="{{ path('app_server_catalog_element_update', { guildId: guild.id, elementId: element.id }) }}" class="bo-form bo-form--tight" data-emoji-picker data-emoji-picker-default="{{ element.emoji_markup }}">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <label class="bo-field">
            Nom
            <input aria-label="Nom" name="name" value="{{ element.name }}" required class="bo-input">
        </label>
        {{ ui.emoji_picker(element.emoji_source, element.emoji_markup, emoji_picker, 'blush') }}
        <button type="submit" class="bo-btn bo-btn--ink bo-btn--lg">Enregistrer</button>
    </form>
    <form method="post" action="{{ path('app_server_catalog_element_delete', { guildId: guild.id, elementId: element.id }) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
        <button type="submit" class="bo-btn bo-btn--danger">Supprimer</button>
    </form>
{% endif %}
