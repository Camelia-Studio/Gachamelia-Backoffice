{% extends 'base_backoffice.html.twig' %}

{% import 'backoffice/_emoji_picker.html.twig' as ui %}

{% import 'backoffice/_icons.html.twig' as icons %}

{% block title %}Configuration - {{ guild.name }} - Gachamélia Backoffice{% endblock %}

{% block navbar_actions %}
    <a href="{{ path('app_dashboard') }}" class="bo-btn bo-btn--outline">Serveurs</a>
{% endblock %}

{% block body %}
    {% set is_overview = active_section == 'overview' %}
    {% set page_icon = is_overview ? 'configuration' : active_configuration_section.icon %}
    {% set page_title = is_overview ? 'Configuration du serveur' : active_configuration_section.label %}
    {% set page_description = is_overview ? 'Choisis une partie du catalogue à compléter pour ce serveur.' : active_configuration_section.description %}

    <section class="bo-page bo-page--wide" data-testid="server-configuration">
        <div class="bo-config">
            <aside class="bo-config-side">
                <div class="bo-identity bo-identity--guild">
                    {% if guild.icon_url %}
                        <img
                            src="{{ guild.icon_url }}"
                            alt="Logo {{ guild.name }}"
                            width="48"
                            height="48"
                            class="bo-guild-icon"
                            loading="lazy"
                        >
                    {% else %}
                        <span class="bo-guild-icon bo-guild-icon--fallback" data-testid="guild-icon-fallback" aria-hidden="true">
                            {{ guild.name|slice(0, 1)|upper }}
                        </span>
                    {% endif %}
                    <div class="bo-guild-text">
                        <p class="bo-identity-name">{{ guild.name }}</p>
                        <p class="bo-identity-sub">{{ read_only ? 'Catalogue inactif' : 'Catalogue actif' }}</p>
                    </div>
                </div>

                <nav class="bo-sidenav" aria-label="Sections de configuration" data-testid="configuration-sidebar">
                    <div class="bo-sidenav-group">
                        <p class="bo-sidenav-title">Serveur</p>
                        <a href="{{ path('app_character_sheet', { guildId: guild.id }) }}" class="bo-sidenav-link">
                            <span class="bo-sidenav-icon">{{ icons.icon('character') }}</span>
                            <span>Fiche personnage</span>
                        </a>
                        <a
                            href="{{ path('app_server_configuration', { guildId: guild.id }) }}"
                            class="bo-sidenav-link{{ is_overview ? ' is-active' }}"
                            data-testid="configuration-nav-overview"
                            {% if is_overview %}aria-current="page"{% endif %}
                        >
                            <span class="bo-sidenav-icon">{{ icons.icon('configuration') }}</span>
                            <span>Configuration</span>
                        </a>
                    </div>

                    <div class="bo-sidenav-group">
                        <p class="bo-sidenav-title">Catalogue</p>
                        {% for section in configuration_sections %}
                            {% set is_active = section.id == active_section %}
                            <a
                                href="{{ path('app_server_configuration_section', { guildId: guild.id, section: section.id }) }}"
                                class="bo-sidenav-link{{ is_active ? ' is-active' }}"
                                data-testid="configuration-nav-{{ section.id }}"
                                {% if is_active %}aria-current="page"{% endif %}
                            >
                                <span class="bo-sidenav-icon">{{ icons.icon(section.icon) }}</span>
                                <span>{{ section.label }}</span>
                                <span class="bo-sidenav-count">{{ section.count }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </nav>
            </aside>

            <div class="bo-config-main">
                <header class="bo-config-header">
                    <span class="bo-config-icon">{{ icons.icon(page_icon) }}</span>
                    <div class="bo-config-heading">
                        <h1 class="bo-page-title">{{ page_title }}</h1>
                        <p class="bo-page-lead bo-page-lead--lg">{{ page_description }}</p>
                    </div>
                </header>

                {% if read_only %}
                    <div class="bo-notice bo-notice--gold" data-testid="inactive-server-notice">
                        <p class="bo-card-title">Serveur inactif</p>
                        <p class="bo-panel-lead">Le catalogue est conservé en lecture seule. Il redeviendra modifiable dès que le bot signalera son retour sur le serveur.</p>
                    </div>
                {% endif %}

                {% include 'backoffice/_catalog_validation.html.twig' with { validation: validation } only %}
                {% include 'backoffice/_catalog_csv_actions.html.twig' with {
                    target_type: 'server',
                    target_id: guild.id,
                    active_section: active_section,
                    read_only: read_only
                } only %}

                <fieldset class="bo-fieldset" data-testid="configuration-read-only" {% if read_only %}disabled{% endif %}>
                {% if is_overview %}
                    <section class="bo-page" data-testid="configuration-overview">
                        <div class="bo-card-grid">
                            {% for section in configuration_sections %}
                                {% set tone = loop.index == 2 ? ' bo-template-mark--gold' : (loop.index == 3 ? ' bo-template-mark--leaf' : '') %}
                                <article class="bo-template-card bo-template-card--large" data-testid="configuration-overview-card-{{ section.id }}">
                                    <div class="bo-panel-head bo-panel-head--bare">
                                        <span class="bo-template-mark{{ tone }}">{{ icons.icon(section.icon) }}</span>
                                        <span class="bo-badge bo-badge--gold bo-badge--lg">{{ section.count }} entrées</span>
                                    </div>
                                    <div class="bo-stack bo-stack--tight">
                                        <h2 class="bo-card-heading">{{ section.label }}</h2>
                                        <p class="bo-page-lead">{{ section.description }}</p>
                                    </div>
                                    <a href="{{ path('app_server_configuration_section', { guildId: guild.id, section: section.id }) }}" class="bo-btn bo-btn--ink bo-btn--lg bo-template-action">
                                        Configurer
                                    </a>
                                </article>
                            {% endfor %}
                        </div>

                        <article class="bo-callout" data-testid="configuration-template-import-card">
                            <div>
                                <h2 class="bo-card-heading">Importer un modèle de catalogue</h2>
                                <p class="bo-page-lead">Démarre depuis un catalogue global préparé par les admins du bot. L’import demande une confirmation car il remplace le catalogue actuel.</p>
                            </div>
                            {% if read_only %}
                                <span class="bo-btn bo-btn--lg bo-btn--static">Import indisponible</span>
                            {% else %}
                                <a href="{{ path('app_server_catalog_template_imports', { guildId: guild.id }) }}" class="bo-btn bo-btn--ink bo-btn--lg">Importer</a>
                            {% endif %}
                        </article>
                    </section>
                {% else %}
                    <div data-testid="configuration-panel">
                        {% if active_section == 'settings' %}
                            <div class="bo-columns bo-columns--side bo-catalog-layout">
                                <section class="bo-panel" data-testid="catalog-create-panel">
                                    <div class="bo-panel-head">
                                        <div>
                                            <h2 class="bo-section-title">Canaux et rôle staff</h2>
                                            <p class="bo-panel-lead">Ces valeurs Discord sont utilisées par le bot pour poster les messages et reconnaître le staff.</p>
                                        </div>
                                    </div>
                                    <form data-catalog-mutation method="post" id="catalog-settings" action="{{ path('app_server_settings_update', { guildId: guild.id }) }}" class="bo-panel-body bo-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
                                        {% if discord_resources.channels is empty and discord_resources.roles is empty %}
                                            <p class="bo-notice bo-notice--rose">Ressources Discord temporairement indisponibles. Les IDs restent éditables manuellement.</p>
                                        {% endif %}
                                        <label class="bo-field">
                                            Salon d’arrivée
                                            {% if discord_resources.channels is not empty %}
                                                <select name="welcome_channel_id" class="bo-input">
                                                    <option value="" {% if not catalog.settings.welcome_channel_id %}selected{% endif %}>Non configuré</option>
                                                    {% if catalog.settings.welcome_channel_id and catalog.settings.welcome_channel_id not in discord_resource_ids.channels %}
                                                        <option value="{{ catalog.settings.welcome_channel_id }}" selected>ID actuel introuvable ({{ catalog.settings.welcome_channel_id }})</option>
                                                    {% endif %}
                                                    {% for channel in discord_resources.channels %}
                                                        {% if channel.type in [0, 5] %}<option value="{{ channel.id }}" {% if catalog.settings.welcome_channel_id == channel.id %}selected{% endif %}>{{ channel.label }}</option>{% endif %}
                                                    {% endfor %}
                                                </select>
                                            {% else %}
                                                <input name="welcome_channel_id" value="{{ catalog.settings.welcome_channel_id }}" inputmode="numeric" placeholder="ID du salon welcome" class="bo-input">
                                            {% endif %}
                                        </label>
                                        <label class="bo-field">
                                            Salon de départ
                                            {% if discord_resources.channels is not empty %}
                                                <select name="bye_channel_id" class="bo-input">
                                                    <option value="" {% if not catalog.settings.bye_channel_id %}selected{% endif %}>Non configuré</option>
                                                    {% if catalog.settings.bye_channel_id and catalog.settings.bye_channel_id not in discord_resource_ids.channels %}
                                                        <option value="{{ catalog.settings.bye_channel_id }}" selected>ID actuel introuvable ({{ catalog.settings.bye_channel_id }})</option>
                                                    {% endif %}
                                                    {% for channel in discord_resources.channels %}
                                                        {% if channel.type in [0, 5] %}<option value="{{ channel.id }}" {% if catalog.settings.bye_channel_id == channel.id %}selected{% endif %}>{{ channel.label }}</option>{% endif %}
                                                    {% endfor %}
                                                </select>
                                            {% else %}
                                                <input name="bye_channel_id" value="{{ catalog.settings.bye_channel_id }}" inputmode="numeric" placeholder="ID du salon bye" class="bo-input">
                                            {% endif %}
                                        </label>
                                        <label class="bo-field">
                                            Rôle staff Discord
                                            {% if discord_resources.roles is not empty %}
                                                <select name="staff_role_id" class="bo-input">
                                                    <option value="" {% if not catalog.settings.staff_role_id %}selected{% endif %}>Non configuré</option>
                                                    {% if catalog.settings.staff_role_id and catalog.settings.staff_role_id not in discord_resource_ids.roles %}
                                                        <option value="{{ catalog.settings.staff_role_id }}" selected>ID actuel introuvable ({{ catalog.settings.staff_role_id }})</option>
                                                    {% endif %}
                                                    {% for role in discord_resources.roles %}
                                                        <option value="{{ role.id }}" {% if catalog.settings.staff_role_id == role.id %}selected{% endif %}>{{ role.label }}</option>
                                                    {% endfor %}
                                                </select>
                                            {% else %}
                                                <input name="staff_role_id" value="{{ catalog.settings.staff_role_id }}" inputmode="numeric" placeholder="ID du rôle staff" class="bo-input">
                                            {% endif %}
                                        </label>
                                        <button type="submit" class="bo-btn bo-btn--ink bo-btn--lg">Enregistrer les réglages</button>
                                    </form>
                                </section>

                                {% include 'backoffice/_catalog_table.html.twig' with { target_type: 'server', target_id: guild.id } %}
                            </div>
                        {% elseif active_section == 'progression' %}
                            <section class="bo-panel bo-panel--padded bo-progression">
                                <div class="bo-progression-intro">
                                    <h2 class="bo-card-heading">Salons autorisés pour l’XP</h2>
                                    <p class="bo-page-lead">Seuls les messages et les périodes vocales dans les salons cochés donnent de l’XP. Une liste vide bloque les gains correspondants. Le bot applique les changements à la prochaine synchronisation du catalogue.</p>
                                </div>
                                <form method="post" action="{{ path('app_server_progression_channels_update', { guildId: guild.id }) }}" class="bo-progression-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
                                    {% if discord_resources.channels is empty %}<p class="bo-notice bo-notice--rose">Les salons Discord sont temporairement indisponibles. Tu peux saisir leurs IDs directement.</p>{% endif %}
                                    <div class="bo-progression-grid">
                                        <fieldset class="bo-progression-group">
                                            <legend>Messages</legend>
                                            {% for channel in discord_resources.channels %}
                                                {% if channel.type in [0, 5] %}
                                                    <label class="bo-channel-choice"><input type="checkbox" name="message_channel_ids[]" value="{{ channel.id }}" {% if channel.id in catalog.progression.message_channel_ids %}checked{% endif %}><span>{{ channel.label }}</span></label>
                                                {% endif %}
                                            {% endfor %}
                                            {% for id in catalog.progression.message_channel_ids %}
                                                {% if id not in discord_resource_ids.channels %}<label class="bo-channel-choice"><input type="checkbox" name="message_channel_ids[]" value="{{ id }}" checked><span>ID actuel introuvable ({{ id }})</span></label>{% endif %}
                                            {% endfor %}
                                            <label class="bo-field">Ajouter des IDs de salons texte
                                                <textarea name="message_channel_ids_manual" class="bo-input" rows="2" placeholder="Un ID par ligne ou séparés par des virgules"></textarea>
                                            </label>
                                        </fieldset>
                                        <fieldset class="bo-progression-group">
                                            <legend>Vocal</legend>
                                            {% for channel in discord_resources.channels %}
                                                {% if channel.type in [2, 13] %}
                                                    <label class="bo-channel-choice"><input type="checkbox" name="voice_channel_ids[]" value="{{ channel.id }}" {% if channel.id in catalog.progression.voice_channel_ids %}checked{% endif %}><span>{{ channel.label }}</span></label>
                                                {% endif %}
                                            {% endfor %}
                                            {% for id in catalog.progression.voice_channel_ids %}
                                                {% if id not in discord_resource_ids.channels %}<label class="bo-channel-choice"><input type="checkbox" name="voice_channel_ids[]" value="{{ id }}" checked><span>ID actuel introuvable ({{ id }})</span></label>{% endif %}
                                            {% endfor %}
                                            <label class="bo-field">Ajouter des IDs de salons vocaux
                                                <textarea name="voice_channel_ids_manual" class="bo-input" rows="2" placeholder="Un ID par ligne ou séparés par des virgules"></textarea>
                                            </label>
                                        </fieldset>
                                    </div>
                                    <div class="bo-progression-actions"><button type="submit" class="bo-btn bo-btn--ink">Enregistrer les salons</button></div>
                                </form>
                            </section>
                            <section class="bo-panel bo-panel--padded bo-progression">
                                <div class="bo-progression-intro">
                                    <h2 class="bo-card-heading">Paliers et gains d’XP</h2>
                                    <p class="bo-page-lead">Associez les rangs du catalogue aux étoiles, puis ajustez les seuils et les gains pour ce serveur.</p>
                                </div>
                                {% if catalog.ranks|filter(rank => not rank.is_staff)|length < 5 %}
                                    <p class="bo-notice bo-notice--gold">Il faut cinq rangs non staff dans le catalogue pour configurer la progression.</p>
                                {% endif %}
                                <form method="post" action="{{ path('app_server_progression_update', { guildId: guild.id }) }}" class="bo-progression-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
                                    <fieldset class="bo-progression-group">
                                        <legend>Rangs et seuils</legend>
                                        <p class="bo-panel-lead">Chaque étape relie un rang au nombre d’XP nécessaire pour atteindre le suivant.</p>
                                        <div class="bo-progression-steps">
                                        {% for i in 0..4 %}
                                            <div class="bo-progression-step">
                                                <label class="bo-field"><span>Rang {{ i + 1 }}★</span>
                                                    <select name="rank_ids[{{ i }}]" class="bo-input" required>
                                                        <option value="">Choisir un rang</option>
                                                        {% for rank in catalog.ranks %}
                                                            {% if not rank.is_staff %}<option value="{{ rank.id }}" {% if catalog.progression.rank_ids[i] == rank.id %}selected{% endif %}>{{ rank.name }}</option>{% endif %}
                                                        {% endfor %}
                                                    </select>
                                                </label>
                                                {% if i < 4 %}
                                            <label class="bo-field"><span>XP vers {{ i + 2 }}★</span>
                                                <input name="thresholds[{{ i }}]" type="number" min="1" value="{{ catalog.progression.thresholds[i] }}" required class="bo-input">
                                            </label>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                        </div>
                                    </fieldset>
                                    <fieldset class="bo-progression-group">
                                        <legend>Quarts de lune</legend>
                                        <p class="bo-panel-lead">Pourcentage du seuil du rang suivant, dans l’ordre croissant.</p>
                                        <div class="bo-progression-grid bo-progression-grid--quarters">
                                        {% for i in 0..3 %}
                                        <label class="bo-field">Quart {{ i + 1 }} · %
                                            <input name="quarter_percentages[{{ i }}]" type="number" min="1" max="99" value="{{ catalog.progression.quarter_percentages[i] }}" required class="bo-input">
                                        </label>
                                        {% endfor %}
                                        </div>
                                    </fieldset>
                                    <fieldset class="bo-progression-group">
                                        <legend>Gains et constellations</legend>
                                        <div class="bo-progression-grid">
                                        <label class="bo-field">XP par constellation
                                        <input name="constellation_threshold" type="number" min="1" value="{{ catalog.progression.constellation_threshold }}" required class="bo-input">
                                        </label>
                                        <label class="bo-field">XP par message normal
                                        <input name="message_xp" type="number" min="1" value="{{ catalog.progression.message_xp }}" required class="bo-input">
                                        </label>
                                        <label class="bo-field">XP par période vocale
                                        <input name="voice_xp" type="number" min="1" value="{{ catalog.progression.voice_xp }}" required class="bo-input">
                                        </label>
                                        <label class="bo-field">Durée d’une période vocale · min
                                        <input name="voice_interval_minutes" type="number" min="1" value="{{ catalog.progression.voice_interval_minutes }}" required class="bo-input">
                                        </label>
                                        </div>
                                    </fieldset>
                                    <div class="bo-progression-actions">
                                        <button type="submit" class="bo-btn bo-btn--ink bo-btn--lg">Enregistrer la progression</button>
                                    </div>
                                </form>
                            </section>
                        {% elseif active_section == 'ranks' %}
                            <div class="bo-columns bo-columns--side bo-catalog-layout">

                                {% include 'backoffice/_catalog_table.html.twig' with { target_type: 'server', target_id: guild.id } %}
                            </div>
                        {% elseif active_section == 'role-stats' %}
                            <div class="bo-columns bo-columns--side bo-catalog-layout">

                                {% include 'backoffice/_catalog_table.html.twig' with { target_type: 'server', target_id: guild.id } %}
                            </div>
                        {% elseif active_section in ['welcome-messages', 'bye-messages'] %}
                            {% set is_welcome_messages = active_section == 'welcome-messages' %}
                            {% set messages = is_welcome_messages ? catalog.welcome_messages : catalog.bye_messages %}
                            {% set create_route = is_welcome_messages ? 'app_server_catalog_welcome_message_create' : 'app_server_catalog_bye_message_create' %}
                            {% set update_route = is_welcome_messages ? 'app_server_catalog_welcome_message_update' : 'app_server_catalog_bye_message_update' %}
                            {% set delete_route = is_welcome_messages ? 'app_server_catalog_welcome_message_delete' : 'app_server_catalog_bye_message_delete' %}
                            {% set create_title = is_welcome_messages ? 'Ajouter un message d’arrivée' : 'Ajouter un message de départ' %}
                            {% set list_title = is_welcome_messages ? 'Messages d’arrivée' : 'Messages de départ' %}
                            {% set submit_label = is_welcome_messages ? 'Ajouter le message d’arrivée' : 'Ajouter le message de départ' %}
                            <div class="bo-columns bo-columns--side bo-catalog-layout">

                                {% include 'backoffice/_catalog_table.html.twig' with { target_type: 'server', target_id: guild.id } %}
                            </div>
                        {% elseif active_section == 'roles' %}
                            <div class="bo-columns bo-columns--side bo-catalog-layout">

                                {% include 'backoffice/_catalog_table.html.twig' with { target_type: 'server', target_id: guild.id } %}
                            </div>
                        {% elseif active_section == 'stats' %}
                            <div class="bo-columns bo-columns--side bo-catalog-layout">

                                {% include 'backoffice/_catalog_table.html.twig' with { target_type: 'server', target_id: guild.id } %}
                            </div>
                        {% elseif active_section == 'elements' %}
                            <div class="bo-columns bo-columns--side bo-catalog-layout">

                                {% include 'backoffice/_catalog_table.html.twig' with { target_type: 'server', target_id: guild.id } %}
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
                </fieldset>
            </div>
        </div>
    </section>
{% endblock %}
