{% extends 'base_backoffice.html.twig' %}

{% block title %}Import CSV · {{ section.label }} · Gachamélia Backoffice{% endblock %}

{% block navbar_actions %}
    <a href="{{ routes.back }}" class="bo-btn bo-btn--outline">Retour au catalogue</a>
{% endblock %}

{% block body %}
    <section class="bo-page bo-page--narrow" data-testid="catalog-csv-upload">
        <header class="bo-page-header">
            <p class="bo-eyebrow">{{ target_name }} · Import CSV</p>
            <h1 class="bo-page-title">{{ section.label }}</h1>
            <p class="bo-page-lead bo-page-lead--lg">
                Les doublons sont mis à jour, les nouvelles lignes sont ajoutées et les entrées absentes du fichier sont conservées. Le fichier complet est appliqué en une seule transaction après confirmation.
            </p>
        </header>

        {% for error in errors %}
            <div class="bo-flash bo-flash--error" data-testid="catalog-csv-error">
                {% if error.line %}Ligne {{ error.line }}{% if error.column %}, colonne « {{ error.column }} »{% endif %} : {% endif %}
                {{ error.message }}
                {% if error.value %}<span class="bo-muted">({{ error.value }})</span>{% endif %}
            </div>
        {% endfor %}

        <section class="bo-panel bo-panel--padded">
            <div class="bo-panel-head bo-panel-head--bare">
                <div>
                    <h2 class="bo-card-heading">Choisir le fichier</h2>
                    <p class="bo-panel-lead">CSV UTF-8 ou UTF-16 avec BOM, séparateur « ; » ou « , », 5 Mio et 1 000 lignes maximum.</p>
                </div>
                <a href="{{ routes.example }}" class="bo-btn bo-btn--outline">Télécharger l’exemple</a>
            </div>
            <p class="bo-panel-lead">Colonnes : {{ section.headers|join(' ; ') }}. Obligatoires : {{ section.requiredHeaders|join(', ') }}. Garde la première ligne d’en-tête ; les pourcentages sont des entiers sans « % ».</p>
            <p class="bo-panel-lead">L’exemple reprend les noms déjà présents et propose des totaux de 100 %. Les emojis acceptent les caractères Unicode. Les textes contenant un séparateur doivent être entourés de guillemets.</p>
            {% if section.value in ['welcome-messages', 'bye-messages'] %}
                <p class="bo-panel-lead">Crée les rangs avant les messages. Sans rang, l’exemple contient uniquement l’en-tête. Pour de nouveaux rangs de serveur, l’import demande ensuite de choisir les rôles Discord.</p>
            {% elseif section.value == 'role-stats' %}
                <p class="bo-panel-lead">Crée les rôles et les stats avant leurs probabilités. Sans ces données, l’exemple contient uniquement l’en-tête. Le total de chaque rôle modifié doit atteindre 100 %.</p>
            {% endif %}
            <form method="post" action="{{ routes.preview }}" enctype="multipart/form-data" class="bo-upload">
                <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
                <label class="bo-field bo-field--strong">
                    Fichier CSV
                    <input type="file" name="csv_file" accept=".csv,text/csv" required class="bo-input bo-input--file">
                </label>
                <button type="submit" class="bo-btn bo-btn--ink bo-btn--xl">Prévisualiser</button>
            </form>
        </section>

        {% if preview %}
            <section class="bo-panel bo-panel--padded bo-panel--white" data-testid="catalog-csv-preview">
                <div class="bo-inline bo-inline--center">
                    <h2 class="bo-card-heading bo-grow">Aperçu avant confirmation</h2>
                    <span class="bo-badge bo-badge--leaf bo-badge--lg">{{ preview.counts.creates }} création(s)</span>
                    <span class="bo-badge bo-badge--gold bo-badge--lg">{{ preview.counts.updates }} mise(s) à jour</span>
                    <span class="bo-badge bo-badge--muted bo-badge--lg">{{ preview.counts.unchanged }} inchangée(s)</span>
                </div>

                {% if preview.totals is not empty %}
                    <div class="bo-columns bo-columns--half" data-testid="catalog-csv-totals">
                        {% for total in preview.totals %}
                            <div class="bo-total {{ total.valid ? 'is-valid' : 'is-invalid' }}">
                                <p class="bo-card-title">{{ total.label }}</p>
                                <p class="bo-panel-lead">{{ total.current }} % actuellement → {{ total.projected }} % après import</p>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="bo-table-wrap">
                    <table class="bo-table">
                        <thead>
                            <tr><th>Ligne</th><th>Action</th><th>Avant</th><th>Après</th></tr>
                        </thead>
                        <tbody>
                            {% for operation in preview.operations %}
                                <tr data-testid="catalog-csv-operation" data-action="{{ operation.action }}">
                                    <td class="bo-table-strong">{{ operation.line }}</td>
                                    <td class="bo-table-strong">
                                        {{ operation.action == 'create' ? 'Création' : (operation.action == 'update' ? 'Mise à jour' : 'Inchangée') }}
                                    </td>
                                    <td class="bo-muted">{{ operation.current ? operation.current|json_encode(constant('JSON_UNESCAPED_UNICODE')) : '—' }}</td>
                                    <td>{{ operation.incoming|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <form method="post" action="{{ routes.apply }}" class="bo-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('backoffice') }}">
                    {% for line in preview.discordRoleLines %}
                        <label class="bo-field bo-field--strong">
                            Rôle Discord pour le nouveau rang de la ligne {{ line }}
                            <select name="discord_roles[{{ line }}]" required class="bo-input bo-input--tall">
                                <option value="">Choisir un rôle actuel</option>
                                {% for role in discord_roles %}
                                    <option value="{{ role.id }}">{{ role.label }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    {% endfor %}
                    <button type="submit" class="bo-btn bo-btn--rose bo-btn--xl bo-btn--start">Confirmer et appliquer l’import</button>
                </form>
            </section>
        {% endif %}
    </section>
{% endblock %}
