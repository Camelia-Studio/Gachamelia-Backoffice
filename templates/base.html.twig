<!doctype html>
<html lang="fr">
    <head>
        {% include 'partials/head_common.html.twig' %}
        <title>{% block title %}Gachamélia - Bot gacha communautaire Discord{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Gachamélia transforme les arrivées Discord en invocations gacha communautaires avec rareté, rôle, élément et fiche personnage.{% endblock %}">
        <meta name="robots" content="{% block robots %}index, follow{% endblock %}">
        {% block seo %}{% endblock %}

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}

        {% include 'partials/hot_reload.html.twig' %}
    </head>

    <body data-layout="landing">
        {% block body %}{% endblock %}
    </body>
</html>
