{% extends 'base_backoffice.html.twig' %}

{% block title %}Erreur {{ status_code|default(500) }} - Gachamélia Backoffice{% endblock %}

{% block meta_description %}Une erreur empêche le backoffice Gachamélia d’afficher l’écran demandé.{% endblock %}

{% block body %}
    {% set errorCode = status_code|default(500) %}

    <section class="bo-error" data-testid="backoffice-error-page">
        <div class="bo-error-copy">
            <p class="bo-eyebrow bo-eyebrow--underlined">
                Erreur <span data-testid="backoffice-error-code">{{ errorCode }}</span>
            </p>
            <h1 class="bo-error-title" data-testid="backoffice-error-title">
                {{ block('error_title')|trim }}
            </h1>
            <p class="bo-error-message">
                {{ block('error_message')|trim }}
            </p>
            <div class="bo-actions">
                <a href="{{ path('app_home') }}" class="bo-btn bo-btn--ink bo-btn--lg" data-testid="backoffice-error-home-action">
                    Retour à l’accueil public
                </a>
            </div>
        </div>

        <aside class="bo-error-card">
            <div class="bo-error-card-head">
                <p class="bo-error-card-eyebrow">État du tirage</p>
                <p class="bo-error-card-code">{{ errorCode }}</p>
            </div>
            <div class="bo-error-card-body">
                <div class="bo-error-cell">
                    <small>Écran</small>
                    <b>{{ block('error_card_title')|trim }}</b>
                </div>
                <div class="bo-error-cell bo-error-cell--blush">
                    <small>Action</small>
                    <b>{{ block('error_card_action')|trim }}</b>
                </div>
            </div>
        </aside>
    </section>
{% endblock %}

{% block error_title %}Le tirage a déraillé{% endblock %}
{% block error_message %}L’écran demandé n’a pas pu être servi. Reviens à l’accueil public pour reprendre une route connue pendant que l’équipe garde le backoffice sous contrôle.{% endblock %}
{% block error_card_title %}Réponse indisponible{% endblock %}
{% block error_card_action %}Revenir sur une page stable{% endblock %}
