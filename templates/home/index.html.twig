{% extends 'base.html.twig' %}

{% block seo %}
    <link rel="canonical" href="{{ absolute_url(path('app_home')) }}">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Gachamélia">
    <meta property="og:title" content="Gachamélia - Bot gacha communautaire Discord">
    <meta property="og:description" content="Gachamélia transforme les arrivées Discord en invocations gacha communautaires avec rareté, rôle, élément et fiche personnage.">
    <meta property="og:url" content="{{ absolute_url(path('app_home')) }}">
    <meta property="og:image" content="{{ absolute_url(asset('images/gachamelia-hero.jpg')) }}">
    <meta property="og:image:alt" content="Illustration de l’univers Gachamélia">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Gachamélia - Bot gacha communautaire Discord">
    <meta name="twitter:description" content="Gachamélia transforme les arrivées Discord en invocations gacha communautaires avec rareté, rôle, élément et fiche personnage.">
    <meta name="twitter:image" content="{{ absolute_url(asset('images/gachamelia-hero.jpg')) }}">
    {% set structuredData = {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        'name': 'Gachamélia',
        'applicationCategory': 'Discord bot',
        'operatingSystem': 'Discord',
        'description': 'Gachamélia transforme les arrivées Discord en invocations gacha communautaires avec rareté, rôle, élément et fiche personnage.',
        'url': absolute_url(path('app_home')),
        'image': absolute_url(asset('images/gachamelia-hero.jpg')),
        'creator': {
            '@type': 'Organization',
            'name': 'Camélia Studio',
            'url': 'https://discord.gg/nBuZ9vJ'
        },
        'sameAs': [
            'https://git.crystalyx.net/camelia-studio/Gachamelia',
            'https://discord.gg/nBuZ9vJ'
        ],
        'downloadUrl': 'https://git.crystalyx.net/camelia-studio/Gachamelia/wiki'
    } %}
    <script type="application/ld+json">{{ structuredData|json_encode(320)|raw }}</script>
{% endblock %}

{% block body %}
    {% set heroImage = asset('images/gachamelia-hero.jpg') %}
    {% set botAvatarImage = asset('images/gachamelia-bot-avatar.png') %}
    {% set installUrl = 'https://git.crystalyx.net/camelia-studio/Gachamelia/wiki' %}
    {% set repositoryUrl = 'https://git.crystalyx.net/camelia-studio/Gachamelia' %}
    {% set discordUrl = 'https://discord.gg/nBuZ9vJ' %}

    <main>
        <section class="lp-hero">
            <img
                src="{{ heroImage }}"
                alt="Illustration de l'univers Camélia Studio dans une bibliothèque chaleureuse"
                class="lp-hero-image"
                data-testid="hero-visual"
            >
            <div class="lp-hero-shade lp-hero-shade--x"></div>
            <div class="lp-hero-shade lp-hero-shade--y"></div>

            <nav class="lp-nav" data-mobile-menu>
                <a href="#" class="lp-brand lp-glass">
                    <img src="{{ botAvatarImage }}" alt="">
                    <span>Gachamélia</span>
                </a>

                <div class="lp-nav-links lp-glass">
                    <a href="#bot" data-mobile-menu-link>Le projet</a>
                    <a href="#fiche" data-mobile-menu-link>La fiche</a>
                    <a href="#espaces" data-mobile-menu-link>L’équipe</a>
                    <a href="{{ repositoryUrl }}" target="_blank" rel="noopener noreferrer">Gitea</a>
                    <a href="{{ discordUrl }}" target="_blank" rel="noopener noreferrer">Discord</a>
                </div>

                <div class="lp-nav-actions">
                    <a href="{{ path('app_dashboard') }}" class="lp-btn lp-btn--nav lp-btn--dark" data-testid="landing-backoffice-link">
                        Backoffice
                    </a>
                    <a href="{{ installUrl }}" class="lp-btn lp-btn--nav lp-btn--glass" target="_blank" rel="noopener noreferrer">
                        Ajouter à mon serveur
                    </a>
                </div>

                <button
                    type="button"
                    class="lp-burger lp-glass"
                    aria-controls="mobile-menu"
                    aria-expanded="false"
                    data-mobile-menu-toggle
                >
                    <span class="sr-only">Ouvrir le menu</span>
                    <span class="lp-burger-lines" aria-hidden="true">
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <div class="lp-backdrop" aria-hidden="true" data-mobile-menu-backdrop></div>

                <aside id="mobile-menu" class="lp-drawer" aria-hidden="true" inert data-mobile-menu-panel>
                    <div class="lp-drawer-head">
                        <a href="#" class="lp-drawer-brand" data-mobile-menu-close>
                            <img src="{{ botAvatarImage }}" alt="">
                            <span>Gachamélia</span>
                        </a>
                        <button type="button" class="lp-drawer-close" data-mobile-menu-close>
                            <span class="sr-only">Fermer le menu</span>
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>

                    <div class="lp-drawer-links">
                        <a href="#bot" class="lp-drawer-link" data-mobile-menu-link>Le rituel</a>
                        <a href="#fiche" class="lp-drawer-link" data-mobile-menu-link>La fiche</a>
                        <a href="#espaces" class="lp-drawer-link" data-mobile-menu-link>La collection</a>
                        <a href="{{ path('app_dashboard') }}" class="lp-drawer-link lp-drawer-link--ink" data-testid="landing-backoffice-link">Backoffice</a>
                        <a href="{{ installUrl }}" class="lp-drawer-link lp-drawer-link--rose" target="_blank" rel="noopener noreferrer">Ajouter</a>
                        <a href="{{ repositoryUrl }}" class="lp-drawer-link" target="_blank" rel="noopener noreferrer">Gitea</a>
                        <a href="{{ discordUrl }}" class="lp-drawer-link" target="_blank" rel="noopener noreferrer">Discord</a>
                    </div>

                    <div class="lp-drawer-note">
                        <p class="lp-eyebrow">Invocation</p>
                        <p class="lp-drawer-note-title">1★ à 5★</p>
                        <p class="lp-drawer-note-text">
                            Rareté, rôle, élément : le tirage pose la première page du personnage.
                        </p>
                    </div>
                </aside>
            </nav>

            <div class="lp-hero-body">
                <div class="lp-hero-inner">
                    <p class="lp-eyebrow lp-eyebrow--underlined">Bot gacha communautaire</p>
                    <h1 class="lp-hero-title">
                        Chaque arrivée devient une <em>invocation</em>.
                    </h1>
                    <div class="lp-hero-copy">
                        <p>
                            Sur Discord, Gachamélia transforme un nouveau membre en personnage
                            de l’univers Camélia : une rareté, un rôle, un élément, puis une fiche
                            que la communauté peut retrouver.
                        </p>
                        <div class="lp-hero-actions" data-testid="hero-actions">
                            <a href="#bot" class="lp-btn lp-btn--white">Découvrir le projet</a>
                        </div>
                    </div>
                    <div class="lp-summary lp-summary--mobile">
                        <span class="lp-stat">
                            <small class="lp-stat-label">Rareté</small>
                            <b class="lp-stat-value">1★ à 5★</b>
                        </span>
                        <span class="lp-stat lp-stat--blush">
                            <small class="lp-stat-label">Rôle</small>
                            <b class="lp-stat-value">{{ gachaRole.value }}</b>
                        </span>
                        <span class="lp-stat">
                            <small class="lp-stat-label">Élément</small>
                            <b class="lp-stat-value">{{ gachaElement.value }}</b>
                        </span>
                        <span class="lp-stat lp-stat--rose">
                            <small class="lp-stat-label">Fiche</small>
                            <b class="lp-stat-value">À conserver</b>
                        </span>
                    </div>
                </div>
            </div>

            <div class="lp-summary lp-summary--desktop" data-testid="hero-desktop-gacha-summary">
                <div class="lp-summary-grid" data-testid="hero-desktop-gacha-summary-grid">
                    <span class="lp-stat" data-testid="hero-gacha-summary-card">
                        <small class="lp-stat-label">Rareté</small>
                        <b class="lp-stat-value" data-testid="hero-gacha-summary-value">1★ à 5★</b>
                    </span>
                    <span class="lp-stat lp-stat--blush" data-testid="hero-gacha-summary-card">
                        <small class="lp-stat-label">Rôle</small>
                        <b class="lp-stat-value" data-testid="hero-gacha-summary-value">{{ gachaRole.value }}</b>
                    </span>
                    <span class="lp-stat" data-testid="hero-gacha-summary-card">
                        <small class="lp-stat-label">Élément</small>
                        <b class="lp-stat-value" data-testid="hero-gacha-summary-value">{{ gachaElement.value }}</b>
                    </span>
                    <span class="lp-stat lp-stat--rose" data-testid="hero-gacha-summary-card">
                        <small class="lp-stat-label">Fiche</small>
                        <b class="lp-stat-value" data-testid="hero-gacha-summary-value">À conserver</b>
                    </span>
                </div>
            </div>
        </section>

        <section id="bot" class="lp-section lp-section--cream lp-section--rounded lp-section-anchor">
            <div class="lp-split">
                <p class="lp-eyebrow">Le rituel</p>
                <div class="lp-split-body">
                    <h2 class="lp-title">On ne rejoint pas seulement le serveur. On entre dans la collection.</h2>
                    <p class="lp-lead">
                        Gachamélia donne du relief au premier contact : le salon d’accueil annonce
                        le tirage, révèle une rareté, associe un rôle de personnage et ouvre une
                        petite histoire que le membre peut garder avec lui.
                    </p>
                    <div class="lp-tags">
                        <span class="lp-tag">Invocation d’arrivée</span>
                        <span class="lp-tag">Messages de rareté</span>
                        <span class="lp-tag">Rôle Discord</span>
                        <span class="lp-tag">Élément</span>
                        <span class="lp-tag">Fiche publique</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="lp-section lp-section--ivory">
            <div class="lp-heading">
                <p class="lp-eyebrow lp-eyebrow--spaced">Dans Discord</p>
                <h2 class="lp-title">Le serveur gagne ses petits moments de jeu.</h2>
            </div>

            <div class="lp-steps">
                <article class="lp-step">
                    <span class="lp-step-number">1</span>
                    <h3 class="lp-step-title">Un membre arrive</h3>
                    <p class="lp-step-text">Le salon d’accueil devient une scène, avec un message qui donne tout de suite le ton.</p>
                </article>
                <span class="lp-arrow">→</span>
                <article class="lp-step lp-step--2">
                    <span class="lp-step-number">2</span>
                    <h3 class="lp-step-title">Son identité tombe</h3>
                    <p class="lp-step-text">Protecteur, Comète, Lame Stellaire, Sève, Brume ou Ambre : le tirage lui donne une couleur.</p>
                </article>
                <span class="lp-arrow">→</span>
                <article class="lp-step lp-step--3">
                    <span class="lp-step-number">3</span>
                    <h3 class="lp-step-title">La fiche reste</h3>
                    <p class="lp-step-text">La fiche perso garde la trace du tirage et donne à chacun une place visible dans la collection.</p>
                </article>
            </div>
        </section>

        <section id="fiche" class="lp-section lp-section--leaf lp-section-anchor lp-fiche">
            <div>
                <p class="lp-eyebrow lp-eyebrow--spaced lp-eyebrow--light">La fiche</p>
                <h2 class="lp-title">Une carte personnage à garder sous la main.</h2>
                <p class="lp-lead">
                    La fiche garde le souvenir du tirage : rareté, rôle, éléments, statistiques
                    et emblème aujourd’hui. Demain, elle pourra raconter les quêtes remportées,
                    les objets découverts et la progression du personnage.
                </p>
            </div>

            <aside class="lp-card">
                <div class="lp-card-head">
                    <span class="lp-badge">Invocation confirmée</span>
                    <h3 class="lp-card-title">Membre<br>{{ gachaRarity }}★</h3>
                </div>
                <div class="lp-card-grid">
                    <div class="lp-card-cell">
                        <small>Rôle</small>
                        <b>{{ gachaRole.value }}</b>
                    </div>
                    <div class="lp-card-cell">
                        <small>Élément</small>
                        <b>{{ gachaElement.value }}</b>
                    </div>
                    <div class="lp-card-cell">
                        <small>Rareté</small>
                        <b>{{ gachaRarity }} étoiles</b>
                    </div>
                    <div class="lp-card-cell">
                        <small>Stat</small>
                        <b>{{ gachaStat.value }}</b>
                    </div>
                </div>
            </aside>
        </section>

        <section id="espaces" class="lp-section lp-section--cream lp-section-anchor">
            <div class="lp-split">
                <p class="lp-eyebrow">Pour qui ?</p>
                <div>
                    <h2 class="lp-title">Une collection à rejoindre, un univers à faire grandir.</h2>
                    <p class="lp-lead">
                        Les membres viennent découvrir qui le serveur leur a confié. L’équipe,
                        elle, garde la main sur les mots, les raretés et les petites surprises
                        qui donnent au rituel sa couleur.
                    </p>
                </div>
            </div>

            <div class="lp-audience">
                <article class="lp-panel">
                    <h3 class="lp-panel-title">Pour les membres</h3>
                    <p class="lp-panel-text">
                        Retrouver leur fiche, comparer leur tirage et suivre leur progression
                        quand les quarts de lune, constellations et hauts-faits arriveront.
                    </p>
                    <ul class="lp-panel-tags">
                        <li>Fiche perso</li>
                        <li>Rareté</li>
                        <li>Élément</li>
                        <li>Progression</li>
                    </ul>
                </article>

                <article class="lp-panel lp-panel--ink">
                    <h3 class="lp-panel-title">Pour l’équipe</h3>
                    <p class="lp-panel-text">
                        Écrire les invocations, composer les raretés, choisir les rôles et préparer
                        les prochaines histoires qui apparaîtront dans le serveur.
                    </p>
                    <ul class="lp-panel-tags">
                        <li>Invocations</li>
                        <li>Raretés</li>
                        <li>Rôles</li>
                        <li>Quêtes</li>
                    </ul>
                </article>
            </div>
        </section>

        <section class="lp-section lp-section--ink lp-closing">
            <div class="lp-heading">
                <p class="lp-eyebrow lp-eyebrow--underlined">Gachamélia</p>
                <h2 class="lp-title">Un bot pour donner une place à chacun dans l’histoire du serveur.</h2>
                <p class="lp-lead">
                    Aujourd’hui, Gachamélia pose le rituel d’arrivée et la fiche. La suite construit
                    une aventure complète autour de l’activité, des inventaires, des combats et des succès.
                </p>
                <div class="lp-actions">
                    <a href="{{ installUrl }}" class="lp-btn lp-btn--lg lp-btn--white" target="_blank" rel="noopener noreferrer">Ajouter à mon serveur</a>
                    <a href="{{ repositoryUrl }}" class="lp-btn lp-btn--lg lp-btn--outline" target="_blank" rel="noopener noreferrer">Voir le Gitea</a>
                    <a href="{{ discordUrl }}" class="lp-btn lp-btn--lg lp-btn--outline" target="_blank" rel="noopener noreferrer">Rejoindre Discord</a>
                </div>
            </div>
            <img
                src="{{ botAvatarImage }}"
                alt="Avatar Discord du bot Gachamélia"
                class="lp-avatar"
                data-testid="bot-avatar-visual"
            >
        </section>
    </main>
{% endblock %}
