    {
      "name": "Champ et libellé",
      "kind": "input",
      "refersTo": "input",
      "description": "Champ du catalogue, label visible et focus hérité.",
      "html": "<label class=\"ds-field\">Message<input class=\"ds-input\" type=\"search\" placeholder=\"Contient…\"></label>",
      "css": ".ds-field{display:grid;gap:.25rem;font-family:var(--font-sans);font-size:.875rem;font-weight:700;color:var(--muted)}.ds-input{width:100%;min-height:2.75rem;padding:0 .75rem;border:1px solid var(--input-border);border-radius:var(--radius-control);background:var(--surface);font-weight:500;color:var(--ink);caret-color:var(--rose)}.ds-input::placeholder{color:var(--muted);opacity:1}.ds-input:focus-visible{outline:none;box-shadow:var(--focus-ring)}.ds-input:disabled{background:var(--ivory);color:var(--muted)}"
    },
    {
      "name": "Navigation de catégorie",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Catégorie active contrastée, SVG transparent, libellé visible et compteur.",
      "html": "<nav aria-label=\"Sections de configuration\"><a class=\"ds-nav\" href=\"#arrivees\" aria-current=\"page\"><span class=\"ds-nav-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M14 4h6v16h-6M3 12h12M10 7l5 5-5 5\"/></svg></span><span>Arrivées</span><span class=\"ds-nav-count\">4</span></a></nav>",
      "css": ".ds-nav{position:relative;display:grid;min-height:2.75rem;grid-template-columns:1.8rem minmax(0,1fr) auto;align-items:center;gap:.75rem;padding:0 .75rem;border-radius:var(--radius-control);background:var(--contrast-bg);color:var(--contrast-fg);font-family:var(--font-sans);font-size:.875rem;font-weight:600;text-decoration:none;transition:color .15s,filter .15s}.ds-nav-icon{display:flex;width:1.75rem;height:1.75rem;align-items:center;justify-content:center;border:1px solid transparent;border-radius:var(--radius-control);background:transparent;color:inherit}.ds-nav-icon svg{display:block;width:1.5rem;height:1.5rem;flex-shrink:0}.ds-nav-count{font-size:.75rem;font-weight:800;color:inherit}.ds-nav:hover{background:var(--blush);color:var(--ink);filter:brightness(.9)}.ds-nav:focus-visible{outline:none;box-shadow:var(--focus-ring)}@media(prefers-reduced-motion:reduce){.ds-nav{transition:none}}"
    },
    {
      "name": "Badge rose",
      "kind": "chip",
      "refersTo": "badge-rose",
      "description": "Badge de statut non interactif.",
      "html": "<span class=\"ds-badge\">Brouillon</span>",
      "css": ".ds-badge{display:inline-flex;min-height:1.75rem;align-items:center;padding:0 .75rem;border-radius:999px;background:var(--blush);color:var(--rose);font-family:var(--font-sans);font-size:.75rem;font-weight:800;white-space:nowrap}"
    },
    {
      "name": "Carte",
      "kind": "card",
      "refersTo": "card",
      "description": "Carte de contenu arrondie, avec bordure et sans ombre.",
      "html": "<article class=\"ds-card\"><h3 class=\"ds-card-title\">Actions CSV</h3><p class=\"ds-card-text\">Fusionne les lignes du fichier avec cette section du catalogue.</p></article>",
      "css": ".ds-card{display:grid;gap:1rem;padding:1.25rem;border:1px solid var(--line);border-radius:var(--radius-panel);background:var(--surface);font-family:var(--font-sans);color:var(--ink)}.ds-card-title{margin:0;font-weight:800}.ds-card-text{margin:.5rem 0 0;max-width:42rem;font-size:.875rem;line-height:1.5rem;color:var(--muted)}"
    },
    {
      "name": "Tableau de catalogue",
      "kind": "custom",
      "description": "Tableau sémantique avec région de défilement focalisable et en-tête de tri.",
      "html": "<div class=\"ds-table-wrap\" tabindex=\"0\" role=\"region\" aria-label=\"Tableau des arrivées\"><table class=\"ds-table\"><thead><tr><th scope=\"col\" aria-sort=\"ascending\"><button class=\"ds-sort\" type=\"button\" aria-label=\"Trier par Rang\">Rang</button></th><th scope=\"col\">Message</th></tr></thead><tbody><tr><td>Rang 1</td><td>Bienvenue, {user}.</td></tr></tbody></table></div>",
      "css": ".ds-table-wrap{overflow-x:auto;min-width:0;border:1px solid var(--line);border-radius:var(--radius-soft);background:var(--surface);scrollbar-color:color-mix(in srgb,var(--ink) 30%,var(--cream)) var(--cream)}.ds-table{width:100%;min-width:36rem;border-collapse:collapse;text-align:left;font-family:var(--font-sans);font-size:.875rem;font-variant-numeric:tabular-nums;color:var(--ink)}.ds-table thead{background:var(--ivory);font-size:.75rem;letter-spacing:.025em;text-transform:uppercase;color:var(--muted)}.ds-table th{font-weight:800}.ds-table th,.ds-table td{padding:.75rem}.ds-table tbody tr{border-top:1px solid var(--line)}.ds-table td{font-weight:600}.ds-sort{font:inherit;color:inherit;text-align:left;background:transparent;border:0;padding:0;text-decoration:underline;text-underline-offset:.25em;cursor:pointer}.ds-sort:hover{filter:brightness(.9)}.ds-sort:focus-visible{outline:none;box-shadow:var(--focus-ring)}.ds-table-wrap:focus-visible{outline:3px solid var(--ink);outline-offset:3px}.ds-table th[aria-sort=\"ascending\"] .ds-sort,.ds-table th[aria-sort=\"descending\"] .ds-sort{color:var(--ink);font-weight:800}"
    },
    {
      "name": "Carte de catégorie ou modèle",
      "kind": "card",
      "refersTo": "template-card",
      "description": "Carte ivoire arrondie à 16px avec marque douce à 12px ; variante de catégorie et de modèle.",
      "html": "<article class=\"ds-template-card\"><span class=\"ds-template-mark\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 7h16M4 17h16M8 4v6M16 14v6\"/></svg></span><h3 class=\"ds-template-heading\">Réglages</h3><p class=\"ds-template-copy\">Les canaux Discord et le rôle staff utilisés par le bot.</p><button class=\"ds-template-action\" type=\"button\">Configurer</button></article>",
      "css": ".ds-template-card{display:grid;min-height:16rem;gap:1.25rem;padding:1.5rem;border:1px solid var(--line);border-radius:var(--radius-panel);background:var(--ivory);box-shadow:var(--shadow-sm);font-family:var(--font-sans);color:var(--ink)}.ds-template-mark{display:flex;width:3.5rem;height:3.5rem;align-items:center;justify-content:center;border-radius:var(--radius-soft);background:var(--blush);color:var(--rose)}.ds-template-mark svg{display:block;width:1.75rem;height:1.75rem;flex-shrink:0}.ds-template-heading{margin:0;font-size:1.25rem;font-weight:800}.ds-template-copy{margin:.5rem 0 0;max-width:42rem;font-size:.875rem;line-height:1.5rem;color:var(--muted)}.ds-template-action{display:inline-flex;justify-self:start;min-height:2.5rem;align-items:center;justify-content:center;margin-top:auto;padding:0 1rem;border:1px solid transparent;border-radius:999px;background:var(--ink);color:var(--on-strong);font-family:var(--font-sans);font-size:.8rem;font-weight:800;transition:background-color .15s,color .15s,filter .15s}.ds-template-action:hover{background:var(--rose);filter:brightness(.9)}.ds-template-action:focus-visible{outline:none;box-shadow:var(--focus-ring)}@media(prefers-reduced-motion:reduce){.ds-template-action{transition:none}}"
    },
    {
      "name": "Bascule de thème et Système",
      "kind": "custom",
      "refersTo": "theme-toggle",
      "description": "Deux boutons dans l’en-tête sombre ; aperçu du mode Système clair. La logique et la révélation circulaire restent dans le module de thème.",
      "html": "<div class=\"ds-theme-header\"><div class=\"ds-theme-controls\" role=\"group\" aria-label=\"Thème du backoffice\"><button class=\"ds-theme-button ds-theme-toggle\" type=\"button\" data-dark=\"false\" aria-label=\"Activer le thème sombre\"><svg class=\"ds-theme-icon ds-theme-icon--sun\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41\"/></svg><svg class=\"ds-theme-icon ds-theme-icon--moon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z\"/></svg></button><button class=\"ds-theme-button ds-theme-system\" type=\"button\" aria-label=\"Suivre le thème du système\" aria-pressed=\"true\">Système</button></div></div>",
      "css": ".ds-theme-header{padding:.65rem 1rem;background:var(--contrast-bg);color:var(--contrast-fg)}.ds-theme-controls{display:flex;align-items:center;gap:.4rem}.ds-theme-button{display:inline-flex;min-height:2.5rem;align-items:center;justify-content:center;padding:0 1rem;border:1px solid color-mix(in srgb,var(--contrast-fg) 25%,transparent);border-radius:999px;background:transparent;color:var(--contrast-fg);font-family:var(--font-sans);font-size:.8rem;font-weight:800;transition:background-color .15s,color .15s,border-color .15s}.ds-theme-toggle{position:relative;width:2.75rem;min-height:2.75rem;padding:0;flex-shrink:0}.ds-theme-icon{position:absolute;width:1.2rem;height:1.2rem}.ds-theme-toggle:not([data-dark=\"true\"]) .ds-theme-icon--moon,.ds-theme-toggle[data-dark=\"true\"] .ds-theme-icon--sun{display:none}.ds-theme-system[aria-pressed=\"true\"]{background:color-mix(in srgb,var(--contrast-fg) 15%,transparent)}.ds-theme-button:hover{background:color-mix(in srgb,var(--contrast-fg) 10%,transparent);color:var(--contrast-fg);filter:none}.ds-theme-button:focus-visible{outline:none;box-shadow:var(--focus-ring)}.ds-theme-button:disabled{opacity:.55;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-theme-button{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Identité crème, encre et rose",
    "overview": "Ce document décrit l’identité conservée et son rapprochement visuel validé avec\nle backoffice Kiss-Shot : en-tête sombre, titres compacts et surfaces adoucies.\nLe socle partagé reste celui de `assets/styles/base.css` ; les composants et les\nsubstitutions du thème sont définis dans `assets/styles/backoffice.css`.\n\nLes titres Fraunces conservent leur caractère éditorial, tandis que DM Sans porte\nles contrôles et les données. L’interface privilégie les panneaux arrondis,\nles boutons en pilule et les repères rose. La variante sombre conserve ces formes,\nces espacements et les rôles de couleur ; elle modifie leurs valeurs uniquement.",
    "keyCharacteristics": [
      "Crème et ivoire en mode clair ; surfaces chaudes sombres dans le backoffice.",
      "Titres Fraunces, textes et contrôles DM Sans.",
      "En-tête sombre dans les deux thèmes, navigation active contrastée.",
      "Panneaux arrondis, petites surfaces douces, boutons et badges en pilule.",
      "Catégories identifiées par un SVG accompagné d’un libellé.",
      "Couleurs sémantiques partagées par les composants des deux thèmes."
    ],
    "rules": [
      {
        "name": "The Scoped Theme Rule",
        "body": "Le choix Clair / Sombre / Système et l’attribut de\nthème appartiennent au document du backoffice ; la vitrine conserve son identité\nclaire et son point d’entrée séparé. Sombre explicite et Système avec préférence\nOS sombre utilisent exactement les mêmes substitutions de tokens.",
        "section": "colors"
      },
      {
        "name": "The Semantic Pair Rule",
        "body": "Les actions fortes et le badge Backoffice associent\nleur fond à `on-strong` ; l’en-tête et la catégorie active associent `contrast-bg`\nà `contrast-fg` ; les champs associent `surface` à `ink`. Ces couples suivent la\nvariante active.\n",
        "section": "colors"
      },
      {
        "name": "The Labeled Category Rule",
        "body": "Une catégorie reste identifiée par un libellé\nvisible accompagné d’un SVG. Les emojis choisis pour les personnages restent\nune donnée du catalogue, distincte de cette navigation.",
        "section": "components"
      }
    ],
    "dos": [
      "Do réutiliser les rôles CSS sémantiques et leurs couples de texte/fond.",
      "Do conserver Fraunces pour les titres et DM Sans pour les contrôles.",
      "Do réutiliser les rayons panel, soft et control selon la taille du conteneur.",
      "Do garder le libellé visible des catégories à côté de leur SVG.",
      "Do conserver les états, messages et focus dans les deux palettes."
    ],
    "donts": [
      "Don't appliquer la préférence de thème du backoffice à la vitrine.",
      "Don't remplacer un rôle de couleur par une valeur blanche/noire locale.",
      "Don't transformer les anciens surtitres espacés en règle pour de nouvelles surfaces.",
      "Don't traiter les aperçus de rampes du sidecar comme des tokens CSS existants."
    ]
  }
}
